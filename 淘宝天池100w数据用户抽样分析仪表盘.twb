      <column caption='Behavior type' datatype='string' name='[Behavior_type]' role='dimension' type='nominal' />
      <column caption='Frequency' datatype='integer' name='[Calculation_5493011643715584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [User_Id]:COUNTD(IF [Behavior_type]=&apos;buy&apos; THEN [Item_Id] END)}' />
      </column>
      <column caption='Recency_score' datatype='integer' name='[Calculation_5493011649212420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Frequency (复制)_5493011646484481]&gt;={FIXED :PERCENTILE([Frequency (复制)_5493011646484481],0.75)} THEN 1&#10;ELSEIF [Frequency (复制)_5493011646484481]&gt;={FIXED :PERCENTILE([Frequency (复制)_5493011646484481],0.5)} THEN 2&#10;ELSEIF [Frequency (复制)_5493011646484481]&gt;={FIXED :PERCENTILE([Frequency (复制)_5493011646484481],0.25)} THEN 3&#10;ELSE 4 END' />
      </column>
      <column caption='RF' datatype='string' name='[Calculation_5493011652116486]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Calculation_5493011649212420])+STR([Recency_score (复制)_5493011651760133])' />
      </column>
      <column caption='customer_segment' datatype='string' name='[Calculation_5493011653120008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Recency_score (复制)_5493011651760133] &gt;= 4 AND [Calculation_5493011649212420] &gt;= 4 THEN &apos;双高客户&apos;&#10;ELSEIF [Calculation_5493011649212420] &gt;= 3 AND [Recency_score (复制)_5493011651760133] &gt;= 3 THEN &apos;忠诚客户&apos;&#10;ELSEIF [Calculation_5493011649212420] &gt;= 4 AND [Recency_score (复制)_5493011651760133] &lt; 2 THEN &apos;新客&apos;&#10;ELSEIF [Calculation_5493011649212420] &lt; 2 AND [Recency_score (复制)_5493011651760133] &gt;= 4 THEN &apos;重要挽留客户&apos;&#10;ELSEIF [Calculation_5493011649212420] &lt; 2 AND [Recency_score (复制)_5493011651760133] &lt; 2 THEN &apos;彻底流失客户&apos;&#10;ELSE &apos;普通客户&apos;&#10;END' />
      </column>
      <column caption='Category Id' datatype='string' datatype-customized='true' name='[Category_Id]' role='dimension' type='nominal' />
      <column caption='Recency' datatype='integer' name='[Frequency (复制)_5493011646484481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,{FIXED [User_Id]:MAX(IF [Behavior_type]=&apos;buy&apos; THEN [Date] END)},{MAX([Date])})' />
      </column>
      <column caption='Item Id' datatype='string' datatype-customized='true' name='[Item_Id]' role='dimension' type='nominal' />
      <column caption='RF_score' datatype='integer' name='[RF (复制)_5493011652870151]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MIN([Calculation_5493011649212420])+MIN([Recency_score (复制)_5493011651760133])' />
      </column>
      <column caption='R_最近日期' datatype='date' name='[Recency (复制)_5493011648962563]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [User_Id]:MAX(IF [Behavior_type]=&apos;buy&apos; THEN [Date] END)}' />
